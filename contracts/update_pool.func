#include "stdlib.func";
#include "types.func";

() recv_internal() impure { }

() after_upgrade () impure method_id(7777) {
    int new_min_loan = 300000 * 1000000000;
    int new_max_loan = 3000000 * 1000000000;

    slice ds = get_data().begin_parse();
    int state = ds~load_uint(8);
    int halted? = ds~load_bool();
    int total_balance = ds~load_coins();
    cell minters_ref = ds~load_ref();
    int interest_rate = ds~load_share();
    int optimistic_deposit_withdrawals = ds~load_bool();
    int deposits_open? = ds~load_bool();
    int saved_validator_set_hash = ds~load_uint(256);
    cell round_data_ref = ds~load_ref();

    ;; Skip the two old loan_params coins; tail (governance_fee, roles, codes)
    ;; remains in `ds`.
    ds~load_coins();
    ds~load_coins();

    set_data(begin_cell()
        .store_uint(state, 8)
        .store_bool(halted?)
        .store_coins(total_balance)
        .store_ref(minters_ref)
        .store_share(interest_rate)
        .store_bool(optimistic_deposit_withdrawals)
        .store_bool(deposits_open?)
        .store_uint(saved_validator_set_hash, 256)
        .store_ref(round_data_ref)
        .store_coins(new_min_loan)
        .store_coins(new_max_loan)
        .store_slice(ds)
    .end_cell());
}
